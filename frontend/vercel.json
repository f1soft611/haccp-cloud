{
  "rewrites": [
    {
      "source": "/haccp-cloud/auth/:path*",
      "destination": "http://218.155.74.34/haccp-cloud/auth/:path*"
    },
    {
      "source": "/haccp-cloud/api/:path*",
      "destination": "http://218.155.74.34/haccp-cloud/api/:path*"
    },
    {
      "source": "/minio-proxy/:path*",
      "destination": "http://218.155.74.34:9000/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/minio-proxy/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}