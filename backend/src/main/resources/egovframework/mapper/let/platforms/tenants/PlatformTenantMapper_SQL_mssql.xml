<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="TenantInfoDAO">

    <!-- 업체 대시보드 item resultMap -->
    <resultMap id="platformTenantDashboardItemResultMap" type="egovframework.let.platforms.tenants.domain.model.PlatformTenantDashboardItemVO">
        <result property="tenantCode" column="tenant_code"/>
        <result property="companyName" column="company_name"/>
        <result property="adminName" column="admin_name"/>
        <result property="adminEmail" column="admin_email"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="corporateNumber" column="corporate_number"/>
        <result property="businessType" column="business_type"/>
        <result property="businessCategory" column="business_category"/>
    </resultMap>

    <!-- 최근 테넌트 resultMap -->
    <resultMap id="sampleTenantResultMap" type="egovframework.let.platforms.tenants.domain.model.SampleTenantVO">
        <result property="tenantCode" column="tenant_code"/>
        <result property="companyName" column="company_name"/>
        <result property="businessRegistrationNumber" column="business_registration_number"/>
        <result property="adminEmail" column="admin_email"/>
        <result property="issuedAt" column="issued_at"/>
    </resultMap>

    <!-- 최대 업체코드 조회 -->
    <select id="TenantInfoDAO.selectMaxTenantCode" resultType="string">
        SELECT ISNULL(MAX(factory_code), '000000')
        FROM tb_factoryinfo
        WHERE factory_code LIKE '[0-9][0-9][0-9][0-9][0-9][0-9]'
    </select>

    <!-- 업체 등록 -->
    <insert id="TenantInfoDAO.insertTenant" parameterType="map">
        INSERT INTO tb_factoryinfo (
            factory_code,
            factory_nm,
            tenant_code,
            admin_email,
            corporate_number,
            business_type,
            business_category
        ) VALUES (
            #{tenantSerialCode},
            #{tenantNm},
            #{tenantCode},
            #{adminEmail},
            #{corporateNumber},
            #{businessType},
            #{businessCategory}
        )
    </insert>

    <!-- 조건별 테넌트 건수 조회 -->
    <select id="TenantInfoDAO.selectTenantCount" parameterType="map" resultType="int">
        SELECT COUNT(*)
        FROM tb_factoryinfo
        WHERE 1=1
        <if test="searchKeyword != null and searchKeyword != ''">
            <choose>
                <when test="searchField == 'tenantCode'">
                    AND tenant_code LIKE '%' + #{searchKeyword} + '%'
                </when>
                <when test="searchField == 'adminName'">
                    AND ISNULL(admin_email, '') LIKE '%' + #{searchKeyword} + '%'
                </when>
                <otherwise>
                    AND factory_nm LIKE '%' + #{searchKeyword} + '%'
                </otherwise>
            </choose>
        </if>
        <if test="status != null and status != '' and status == 'ACTIVE'">
            AND use_at = 'Y'
        </if>
        <if test="status != null and status != '' and status == 'INACTIVE'">
            AND use_at = 'N'
        </if>
        <if test="useAtOnly != null and useAtOnly != ''">
            AND use_at = #{useAtOnly}
        </if>
    </select>

    <!-- 대시보드 테넌트 목록 조회 -->
    <select id="TenantInfoDAO.selectDashboardTenantItems" parameterType="map" resultMap="platformTenantDashboardItemResultMap">
        SELECT
            tenant_code,
            factory_nm AS company_name,
            '-' AS admin_name,
            ISNULL(NULLIF(LTRIM(RTRIM(admin_email)), ''), '-') AS admin_email,
            CASE WHEN use_at = 'Y' THEN 'ACTIVE' ELSE 'INACTIVE' END AS status,
            CONVERT(VARCHAR(19), created_at, 126) + 'Z' AS created_at,
            corporate_number,
            business_type,
            business_category
        FROM tb_factoryinfo
        WHERE 1=1
        <if test="searchKeyword != null and searchKeyword != ''">
            <choose>
                <when test="searchField == 'tenantCode'">
                    AND tenant_code LIKE '%' + #{searchKeyword} + '%'
                </when>
                <when test="searchField == 'adminName'">
                    AND ISNULL(admin_email, '') LIKE '%' + #{searchKeyword} + '%'
                </when>
                <otherwise>
                    AND factory_nm LIKE '%' + #{searchKeyword} + '%'
                </otherwise>
            </choose>
        </if>
        <if test="status != null and status != '' and status == 'ACTIVE'">
            AND use_at = 'Y'
        </if>
        <if test="status != null and status != '' and status == 'INACTIVE'">
            AND use_at = 'N'
        </if>
        ORDER BY created_at DESC
        OFFSET (#{pageIndex} * #{pageSize}) ROWS
        FETCH NEXT #{pageSize} ROWS ONLY
    </select>

    <!-- 최근 발급 테넌트 목록 조회 -->
    <select id="TenantInfoDAO.selectRecentTenants" parameterType="map" resultMap="sampleTenantResultMap">
        SELECT TOP (#{limit})
            tenant_code,
            factory_nm AS company_name,
            corporate_number AS business_registration_number,
            ISNULL(NULLIF(LTRIM(RTRIM(admin_email)), ''), '-') AS admin_email,
            CONVERT(VARCHAR(19), created_at, 126) + 'Z' AS issued_at
        FROM tb_factoryinfo
        ORDER BY created_at DESC
    </select>
</mapper>
