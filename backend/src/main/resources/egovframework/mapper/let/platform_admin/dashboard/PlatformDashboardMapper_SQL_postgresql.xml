<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="PlatformDashboardDAO">

    <!-- 최근 발급 현황 resultMap -->
    <resultMap id="recentIssueResultMap" type="egovframework.let.platform_admin.dashboard.domain.model.PlatformDashboardTenantCodeIssuanceVO$RecentIssueVO">
        <result property="tenantId" column="tenant_id"/>
        <result property="tenantCode" column="tenant_code"/>
        <result property="companyName" column="company_name"/>
        <result property="issuedAt" column="issued_at"/>
        <result property="status" column="status"/>
    </resultMap>

    <!-- 대시보드 테넌트 조건별 건수 조회 -->
    <select id="PlatformDashboardDAO.selectDashboardTenantCount" parameterType="egovframework.let.platform_admin.dashboard.domain.model.PlatformDashboardSearchConditionVO" resultType="int">
        SELECT COUNT(*)
        FROM tb_tenant
        WHERE 1=1
        <if test="searchKeyword != null and searchKeyword != ''">
            <choose>
                <when test="searchField == 'tenantCode'">
                    AND tenant_code ILIKE '%' || #{searchKeyword} || '%'
                </when>
                <when test="searchField == 'adminName'">
                    AND COALESCE(admin_email, '') ILIKE '%' || #{searchKeyword} || '%'
                </when>
                <otherwise>
                    AND tenant_nm ILIKE '%' || #{searchKeyword} || '%'
                </otherwise>
            </choose>
        </if>
        <if test="status != null and status != '' and status == 'ACTIVE'">
            AND use_at = 'Y'
        </if>
        <if test="status != null and status != '' and status == 'INACTIVE'">
            AND use_at = 'N'
        </if>
    </select>

    <!-- 활성 테넌트 건수 조회 -->
    <select id="PlatformDashboardDAO.selectActiveTenantCount" resultType="int">
        SELECT COUNT(*)
        FROM tb_tenant
        WHERE use_at = 'Y'
    </select>

    <!-- 최근 7일 신규 테넌트 건수 조회 -->
    <select id="PlatformDashboardDAO.selectNewTenantsLast7DaysCount" resultType="int">
        SELECT COUNT(*)
        FROM tb_tenant
        WHERE created_at >= (NOW() - INTERVAL '7 days')
    </select>

    <!-- 이번 달 발급 건수 조회 -->
    <select id="PlatformDashboardDAO.selectIssuedThisMonthCount" resultType="int">
        SELECT COUNT(*)
        FROM tb_tenant
        WHERE created_at >= date_trunc('month', NOW())
    </select>

    <!-- 이번 주 발급 건수 조회 -->
    <select id="PlatformDashboardDAO.selectIssuedThisWeekCount" resultType="int">
        SELECT COUNT(*)
        FROM tb_tenant
        WHERE created_at >= date_trunc('week', NOW())
    </select>

    <!-- 최근 발급 이슈 목록 조회 -->
    <select id="PlatformDashboardDAO.selectRecentIssues" parameterType="map" resultMap="recentIssueResultMap">
        SELECT
            tenant_id,
            tenant_code,
            tenant_nm AS company_name,
            TO_CHAR(created_at, 'YYYY-MM-DD"T"HH24:MI:SS"Z"') AS issued_at,
            CASE WHEN use_at = 'Y' THEN 'ACTIVE' ELSE 'INACTIVE' END AS status
        FROM tb_tenant
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>
</mapper>
